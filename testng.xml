<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite
        name="CrossBrowser DemoQA"
        parallel="tests"
        thread-count="3">

    <test name="Chrome">

        <parameter
                name="browser"
                value="chrome"/>

        <parameter
                name="headless"
                value="false"/>

        <classes>
            <class name="tests.TextBoxTest"/>
            <class name="tests.AlertsTest"/>
            <class name="tests.ButtonsTest"/>
            <class name="tests.SliderTest"/>
        </classes>

    </test>

    <test name="Firefox">

        <parameter
                name="browser"
                value="firefox"/>

        <parameter
                name="headless"
                value="false"/>

        <classes>
            <class name="tests.TextBoxTest"/>
            <class name="tests.AlertsTest"/>
            <class name="tests.ButtonsTest"/>
            <class name="tests.SliderTest"/>
        </classes>

    </test>

    <test name="Edge">

        <parameter
                name="browser"
                value="edge"/>

        <parameter
                name="headless"
                value="false"/>

        <classes>
            <class name="tests.TextBoxTest"/>
            <class name="tests.AlertsTest"/>
            <class name="tests.ButtonsTest"/>
            <class name="tests.SliderTest"/>
        </classes>

    </test>

</suite>